{
    box-sizing: border-box;
    margin: 0;
    font-family: Arial, sans-serif;
}

nav {
    background:#255;
    color: white;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav ul {
    display: flex;
    list-style: none;
    }

nav ul li a {
    color: white;
    text-decoration: none;
    margin-left: 15px;
}

 {
    display: none;
    font-size: 20px;
}

.hero {
    background: #4CAF50;
    color: white;
    padding: 80px 20px;
    text-align: center;
    }

.cards {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.card {
    background: #eee;
    padding: 30px;
    width: 200px;
}